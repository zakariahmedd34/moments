# Copy this file to .env (same folder) and fill in the values.

# Secret used to sign login tokens. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# ImageKit keys (https://imagekit.io/dashboard/developer/api-keys)
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL=https://ik.imagekit.io/your_imagekit_id

# Optional. Defaults to SQLite at backend/moments.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/moments

# Optional. How long a login lasts, in seconds (default 7 days)
# JWT_LIFETIME_SECONDS=604800
